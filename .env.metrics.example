# All defaults are isolated local benchmark services. Do not paste production DB URLs.
METRICS_DATABASE_URL=postgresql://metrics:metrics-local-only@127.0.0.1:55432/podcazt_metrics?connection_limit=5
METRICS_REDIS_URL=redis://:metrics-local-only@127.0.0.1:56379/0
METRICS_HOST_LABEL=local benchmark host
METRICS_SAMPLES=100
METRICS_WARMUP=10
METRICS_CONCURRENCY=4
METRICS_DB_ROOMS=5000
METRICS_WEB_PORT=4330
METRICS_SIGNALING_PORT=4430
METRICS_REDIS_SUBSCRIBERS=3
METRICS_UPLOAD_PARTS=6
METRICS_UPLOAD_DELAY_MS=20
METRICS_MEDIA_SECONDS=10
METRICS_MEDIA_RUNS=3
# Empty URL uses an ephemeral local HTTPS proxy and a private, verified test CA.
# For read-only production HTTP/TLS: set an HTTPS origin and run --only=http,tls.
METRICS_HTTP_URL=
METRICS_TLS_CA_FILE=
# Empty browser channel uses the pinned Playwright Chromium install.
# Set chrome to use an installed Google Chrome; its version is recorded in reports.
METRICS_BROWSER_CHANNEL=
METRICS_FORCE_RELAY=false
# Supply short-lived credentials from your TURN service for a relay run.
METRICS_ICE_SERVERS_JSON=[]
# Optional thresholds; examples are illustrative targets, not measured results.
METRICS_BUDGET_FILE=
# Hosted runner uses SSH to reuse the deployed image, with no production secret download.
METRICS_HOSTED_URL=https://podcazt.arisen37.xyz
METRICS_SSH_HOST=13.51.197.83
METRICS_SSH_USER=ubuntu
METRICS_SSH_KEY=enryu.pem
METRICS_DEPLOY_DIR=/opt/podcazt/deploy/aws

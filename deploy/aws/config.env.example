# Copy to config.env. Never commit config.env or runtime.env.
# Finish APP_DOMAIN/TURN_DOMAIN after the static IP and DNS are ready.
TLS_MODE=domain
# TLS_MODE=ip: set both hosts to PUBLIC_IP.
APP_DOMAIN=studio.example.com
TURN_DOMAIN=turn.example.com
# Optional in either TLS mode; leave empty to register without email.
ACME_EMAIL=you@example.com
PUBLIC_IP=203.0.113.10
PRIVATE_IP=172.26.0.10
AWS_REGION=ap-south-1
S3_BUCKET=your-globally-unique-podcazt-bucket
# Lightsail: static. EC2 with a bucket-scoped instance profile: instance-role.
AWS_AUTH_MODE=static
# Leave these empty for instance-role. Never use root-account keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Keep existing values on upgrades. setup-config.ts generates missing secrets.
POSTGRES_PASSWORD=
SESSION_SECRET=
SIGNALING_INTERNAL_SECRET=
TURN_SHARED_SECRET=
GOOGLE_EMAIL=
GOOGLE_APP_PASSWORD=
GOOGLE_FROM_NAME=Podcazt

NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://podcazt.test:8443
# Use 0.0.0.0 to also access HTTPS from devices on your LAN.
LOCAL_HTTPS_BIND_IP=127.0.0.1
# NEXT_PUBLIC_SIGNALING_URL stays unset: the browser uses the same origin's /ws.
POSTGRES_USER=podcazt
POSTGRES_DB=podcazt
POSTGRES_PASSWORD=local-only-postgres-password
DATABASE_URL=postgresql://podcazt:local-only-postgres-password@postgres:5432/podcazt?connection_limit=5
REDIS_URL=redis://redis:6379
SESSION_SECRET=local-only-session-secret-replace-with-32-random-characters
SIGNALING_INTERNAL_SECRET=local-only-internal-secret-replace-with-32-random-characters
SIGNALING_INTERNAL_URL=http://signaling:4000
SIGNALING_PORT=4000
SINGLE_INSTANCE_SIGNALING=true
# Your computer's LAN IPv4, not 127.0.0.1 or the container's address.
LOCAL_TURN_IP=192.168.1.100
TURN_HOST=${LOCAL_TURN_IP}
TURN_SHARED_SECRET=local-only-turn-secret-replace-with-32-random-characters
STORAGE_PROVIDER=s3
AWS_REGION=ap-south-1
S3_BUCKET=replace-with-your-private-test-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional temporary AWS credentials.
AWS_SESSION_TOKEN=
GOOGLE_EMAIL=
GOOGLE_APP_PASSWORD=
GOOGLE_FROM_NAME=Podcazt Local

# Optional: bypass Docker Hub using official publisher registries.
# DOCKER_LIBRARY_PREFIX=public.ecr.aws/docker/library/
# COTURN_IMAGE=ghcr.io/coturn/coturn:latest

{
  "name": "podcazt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:signal": "tsx --env-file=.env server/signaling.ts",
    "start:signal": "NODE_ENV=production tsx server/signaling.ts",
    "build": "next build",
    "start": "next start",
    "postinstall": "node scripts/prisma-postinstall.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:reliability": "node --import tsx --test tests/reliability.test.ts",
    "test:deployment-config": "node --import tsx --test tests/deployment-config.test.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "metrics": "node --env-file-if-exists=.env.metrics --import tsx tests/metrics/run.ts",
    "metrics:local": "node --env-file-if-exists=.env.metrics --import tsx tests/metrics/local.ts",
    "metrics:up": "docker compose -f tests/metrics/compose.yaml up -d --wait",
    "metrics:down": "docker compose -f tests/metrics/compose.yaml down",
    "metrics:browsers": "playwright install chromium",
    "test:metrics": "node --import tsx --test tests/metrics.test.ts",
    "metrics:hosted": "node --env-file-if-exists=.env.metrics --import tsx tests/metrics/hosted.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@aws-sdk/s3-request-presigner": "^3.1148.0",
    "@prisma/client": "^5.20.0",
    "@supabase/supabase-js": "^2.45.4",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^2.4.3",
    "express": "^4.22.3",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "next": "^15.5.27",
    "nodemailer": "^10.0.16",
    "prisma": "^5.20.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsx": "^4.19.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.5",
    "@types/nodemailer": "^6.4.16",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.5.12",
    "esbuild": "0.28.1",
    "eslint": "^9.9.1",
    "eslint-config-next": "^15.0.0",
    "playwright": "1.64.0",
    "typescript": "^5.6.2"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.23"
    }
  }
}
